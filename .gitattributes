# Normalize everything to LF in repo and working tree
*               text=auto eol=lf

# Unity text assets (YAML / text)
*.meta          text eol=lf
*.unity         text eol=lf
*.prefab        text eol=lf
*.mat           text eol=lf
*.anim          text eol=lf
*.controller    text eol=lf
*.asset         text eol=lf
*.lighting      text eol=lf
*.inputactions  text eol=lf
*.scenetemplate text eol=lf
*.shader        text eol=lf
*.cginc         text eol=lf
*.txt           text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.cs            text eol=lf

# Binary assets (never change line endings)
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.fbx  binary
*.wav  binary
*.ttf  binary
*.gif  binary
*.ogg  binary
*.mp3  binary
*.mp4  binary

# Don't ever commit local Unity license files
*.ulf  -text
Unity_*.ulf -text
